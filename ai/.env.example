# --- Model keys (set at least one) ---
# Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
# Optional: enables the Claude models in the model switcher
ANTHROPIC_API_KEY=
# Optional: better web search (free tier at https://tavily.com). Without it the agent uses DuckDuckGo.
TAVILY_API_KEY=

# --- Optional settings ---
# DEFAULT_MODEL=gemini-flash-latest
# BACKEND_URL=http://localhost:4000
# MAX_AGENT_STEPS=8
# TOOL_TIMEOUT_S=20
